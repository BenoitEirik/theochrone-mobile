{
  "name": "com.benoiteirik.theochrone",
  "version": "2.3.0",
  "description": "Le Théochrone, un calendrier liturgique perpétuel selon le rit tridentin (missel de 1962).",
  "productName": "Theochrone",
  "author": "BenoitEirik <olafsergent@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "ionic:serve": "nuxt dev . --host 0.0.0.0 --port 8100",
    "cap:android-icon": "pnpm exec capacitor-assets generate --android --assetPath \"resources\" --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#ffffff\"",
    "test": "pnpm vitest run",
    "custom:dev": "pnpm exec cap run android --target=f96585a7 --live-reload --external --port=8100 --host=${1:-192.168.106.252} & pnpm exec pnpm ionic:serve --no-open --host=${1:-192.168.106.252} --port=8100"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capacitor/text-zoom": "^8.0.1",
    "@pinia/nuxt": "^0.5.5",
    "@popperjs/core": "^2.11.8",
    "jsdom": "^25.0.1",
    "nuxt": "^3.21.11",
    "nuxt-swiper": "^1.2.2",
    "sass": "^1.102.0",
    "v-calendar": "^3.1.2",
    "v-wave": "^2.0.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@indielayer/ui": "^1.18.1",
    "@nuxt/test-utils": "^3.23.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vue/test-utils": "^2.4.11",
    "@vuepic/vue-datepicker": "^8.8.1",
    "@vueuse/core": "^10.11.1",
    "autoprefixer": "^10.5.4",
    "floating-vue": "^5.2.2",
    "nuxt-icon": "^0.6.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vitest": "^2.1.9"
  }
}